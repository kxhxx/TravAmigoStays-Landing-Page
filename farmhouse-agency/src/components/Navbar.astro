---
import { Image } from 'astro:assets';
import myLogo from '../assets/logo.png';
---
<header class="bg-white/95 backdrop-blur-sm border-b border-slate-100 sticky top-0 z-50">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="block hover:opacity-90 transition-opacity">
          <Image 
            src={myLogo} 
            alt="Agency Logo" 
            class="h-10 w-auto object-contain" 
            loading="eager" 
          />
        </a>
      </div>

      <nav class="flex items-center space-x-3 sm:space-x-6">

        <a href="tel:+919818891540" class="group flex items-center text-slate-800 hover:text-purple-600 font-bold transition-colors text-sm sm:text-base">
          <svg class="w-4 h-4 sm:w-5 sm:h-5 mr-1.5 text-purple-600 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
          <span class="hidden sm:inline">+91 9891116444</span>
          <span class="sm:hidden">Call</span>
        </a>

        <a href="#inquiry" class="bg-purple-600 hover:bg-purple-700 text-white px-5 sm:px-6 py-2 sm:py-2.5 rounded-full font-bold transition-all shadow-md hover:shadow-lg transform hover:-translate-y-0.5 text-sm sm:text-base whitespace-nowrap">
          Contact Us
        </a>
      </nav>
      
    </div>
  </div>
</header>