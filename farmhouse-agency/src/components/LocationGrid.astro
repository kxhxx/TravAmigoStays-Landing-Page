---
const locations = [
  { name: 'Gurgaon', desc: 'Modern party pads with pools and sunset views' },
  { name: 'Chhatarpur', desc: 'Luxury wedding estates and palatial farmhouses' },
  { name: 'Manesar', desc: 'Expansive green lawns perfect for corporate offsites' },
  { name: 'Noida & Greater Noida', desc: 'Exclusive stays and quiet getaways' }
];
---
<section class="py-16 md:py-20 px-4 bg-white">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-2xl sm:text-3xl font-bold mb-10 md:mb-12 text-center tracking-tight">Top Locations We Serve</h2>
    
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
      {locations.map(loc => (
        <a href="#inquiry" class="block p-6 border border-slate-100 rounded-2xl hover:shadow-xl transition-all duration-300 bg-slate-50 flex flex-col justify-center text-center sm:text-left group hover:-translate-y-1">
          <h3 class="text-xl font-bold mb-3 text-purple-700 group-hover:text-purple-900 transition-colors">{loc.name}</h3>
          <p class="text-slate-600 leading-relaxed text-sm sm:text-base">{loc.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>