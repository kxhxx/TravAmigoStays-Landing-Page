---
// src/components/EventTypes.astro
---
<section class="pt-10 pb-20 bg-white border-t border-slate-100">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4 tracking-tight">Tailored <span class="text-purple-600">Occasions</span></h2>
      <p class="text-lg text-slate-500 max-w-2xl mx-auto">
        The perfect backdrop for your most important moments.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 sm:gap-8">
      
      <div class="group relative h-72 sm:h-80 rounded-3xl overflow-hidden cursor-pointer shadow-lg">
        <img src="https://images.unsplash.com/photo-1542042161784-26ab9e041e89?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D%22" alt="Luxury Weddings" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8">
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-widest uppercase mb-1">Weddings</h3>
          <p class="text-purple-200 text-sm font-medium">Grand estates & premium decor</p>
        </div>
      </div>

      <div class="group relative h-72 sm:h-80 rounded-3xl overflow-hidden cursor-pointer shadow-lg">
        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=1000&q=80" alt="Corporate Events" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8">
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-widest uppercase mb-1">Corporate</h3>
          <p class="text-purple-200 text-sm font-medium">Offsites & executive retreats</p>
        </div>
      </div>

      <div class="group relative h-72 sm:h-80 rounded-3xl overflow-hidden cursor-pointer shadow-lg">
        <img src="https://images.unsplash.com/photo-1517457373958-b7bdd4587205?auto=format&fit=crop&w=1000&q=80" alt="Private Gatherings" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8">
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-widest uppercase mb-1">Private Gatherings</h3>
          <p class="text-purple-200 text-sm font-medium">Pool parties & celebrations</p>
        </div>
      </div>

      <div class="group relative h-72 sm:h-80 rounded-3xl overflow-hidden cursor-pointer shadow-lg">
        <img src="https://plus.unsplash.com/premium_photo-1682097066897-209d0d9e9ae5?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Photoshoots" class="absolute inset-0 w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-700">
        <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8">
          <h3 class="text-2xl sm:text-3xl font-bold text-white tracking-widest uppercase mb-1">Photoshoots</h3>
          <p class="text-purple-200 text-sm font-medium">Cinematic backdrops & lighting</p>
        </div>
      </div>

    </div>
  </div>
</section>