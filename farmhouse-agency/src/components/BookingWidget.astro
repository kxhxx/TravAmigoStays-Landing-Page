---
// src/components/BookingWidget.astro
---
<div class="max-w-5xl mx-auto px-4 relative z-20 -mt-8 sm:-mt-12 mb-16">
  <div class="bg-white rounded-2xl sm:rounded-full shadow-2xl p-3 sm:p-4 flex flex-col sm:flex-row items-center justify-between gap-4 border border-slate-100">
    
    <div class="flex-1 w-full px-4 sm:border-r border-slate-200">
      <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Arrival</label>
      <input type="date" id="widgetCheckIn" class="w-full text-slate-900 outline-none bg-transparent font-medium cursor-pointer" />
    </div>
    
    <div class="flex-1 w-full px-4 sm:border-r border-slate-200">
      <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Exit</label>
      <input type="date" id="widgetCheckOut" disabled class="w-full text-slate-900 outline-none bg-transparent font-medium cursor-not-allowed opacity-50" />
    </div>
    
    <div class="flex-1 w-full px-4">
      <label class="block text-xs font-semibold text-slate-500 uppercase tracking-wider mb-1">Guests</label>
      <input type="number" id="widgetGuests" min="1" placeholder="Count" class="w-full text-slate-900 outline-none bg-transparent font-medium" />
    </div>
    
    <div class="w-full sm:w-auto mt-2 sm:mt-0">
      <button id="widgetSubmit" class="w-full sm:w-auto bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-8 rounded-full transition-colors whitespace-nowrap shadow-md">
        Check availability
      </button>
    </div>
    
  </div>
</div>

<script>
  // Date Validation Logic
  const wCheckIn = document.getElementById('widgetCheckIn') as HTMLInputElement;
  const wCheckOut = document.getElementById('widgetCheckOut') as HTMLInputElement;
  
  if (wCheckIn && wCheckOut) {
    // Set min date to today
    const today = new Date();
    const tzOffset = today.getTimezoneOffset() * 60000;
    const localISOTime = (new Date(Date.now() - tzOffset)).toISOString().split('T')[0];
    wCheckIn.min = localISOTime;

    wCheckIn.addEventListener('change', (e) => {
      const target = e.target as HTMLInputElement;
      if (target.value) {
        const checkInDate = new Date(target.value);
        const nextDay = new Date(checkInDate);
        nextDay.setDate(checkInDate.getDate() + 1);
        
        const nextDayString = nextDay.toISOString().split('T')[0];
        wCheckOut.min = nextDayString;
        wCheckOut.disabled = false;
        wCheckOut.classList.remove("opacity-50", "cursor-not-allowed");

        if (wCheckOut.value && wCheckOut.value <= target.value) {
          wCheckOut.value = "";
        }
      } else {
        wCheckOut.disabled = true;
        wCheckOut.classList.add("opacity-50", "cursor-not-allowed");
        wCheckOut.value = "";
      }
    });
  }

  // Transfer data to the main form and scroll down
  document.getElementById('widgetSubmit')?.addEventListener('click', () => {
    const mainCheckIn = document.getElementById('checkInDate') as HTMLInputElement;
    const mainCheckOut = document.getElementById('checkOutDate') as HTMLInputElement;
    
    if(wCheckIn.value && mainCheckIn) {
       mainCheckIn.value = wCheckIn.value;
       mainCheckIn.dispatchEvent(new Event('change')); 
    }
    
    if(wCheckOut.value && mainCheckOut) {
       mainCheckOut.disabled = false;
       mainCheckOut.classList.remove("opacity-50", "cursor-not-allowed", "bg-slate-50");
       mainCheckOut.value = wCheckOut.value;
       mainCheckOut.dispatchEvent(new Event('change'));
    }
    
    document.getElementById('inquiry')?.scrollIntoView({ behavior: 'smooth' });
  });
</script>